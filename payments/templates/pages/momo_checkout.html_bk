{% extends "templates/web.html" %}

{% block page_content %}
<div class="checkout-container" style="max-width: 400px; margin: 50px auto;">
    <h3>MTN Mobile Money Payment</h3>
    <p class="text-muted">Payment for: <strong>{{ title or payment_request_name }}</strong></p>
    <hr>
    
    <div class="form-group">
        <label for="momo_number">Enter MTN Phone Number</label>
        <input type="text" id="momo_number" class="form-control" placeholder="e.g. 237670543260" required>
        <small class="form-text text-muted">Include country code without "+" (e.g., 237 for Cameroon).</small>
    </div>

    <div class="mt-4">
        <button id="pay_btn" class="btn btn-primary btn-block">Confirm & Pay: {{ currency }} {{ amount }}</button>
    </div>
    
    <div id="response_msg" class="mt-3 text-center" style="display:none;"></div>
</div>

<script>
frappe.ready(function() {
    let retry_count = 0;
    const max_retries = 12; // 12 * 5 seconds = 60 seconds total

    $("#pay_btn").click(function() {
        const sender = $("#momo_number").val();
        if (!sender) {
            frappe.msgprint(__("Please enter your phone number"));
            return;
        }

        const btn = $(this);
        btn.prop("disabled", true).text(__("Check your phone..."));

        frappe.call({
            method: "payments.payment_gateways.doctype.momo_settings.momo_settings.request_for_payment_by_gateway",
            args: {
                gateway_name: "{{ gateway_name }}",
                request_amount: "{{ amount }}",
                currency: "{{ currency }}",
                sender: sender,
                order_id: "{{ order_id }}",
                reference_doctype: "{{ reference_doctype }}",
                reference_docname: "{{ reference_docname }}"
            },
            callback: function(r) {
                if (r.message && r.message.referenceId) {
                    // Start polling for the status of this specific referenceId
                    start_polling(r.message.referenceId);
                } else {
                    btn.prop("disabled", false).text(__("Try Again"));
                    frappe.msgprint(__("Could not initiate payment. Please check your number."));
                }
            }
        });
    });

    function start_polling(reference_id) {
        $("#response_msg").show().html('<div class="alert alert-info">Awaiting PIN entry on your phone...</div>');
        
        const interval = setInterval(function() {
            retry_count++;

            frappe.call({
                method: "frappe.client.get_value",
                args: {
                    doctype: "Integration Request",
                    filters: { name: reference_id },
                    fieldname: "status"
                },
                callback: function(r) {
                    const status = r.message.status;

                    if (status === "Completed" || status === "Success") {
                        clearInterval(interval);
                        $("#response_msg").html('<div class="alert alert-success">Payment Successful! Redirecting...</div>');
                        // Redirect back to the Invoice/Portal after 2 seconds
                        setTimeout(() => {
                            window.location.href = "/me/payments"; 
                        }, 2000);
                    } 
                    else if (status === "Failed") {
                        clearInterval(interval);
                        $("#pay_btn").prop("disabled", false).text(__("Try Again"));
                        $("#response_msg").html('<div class="alert alert-danger">Payment Failed or Cancelled.</div>');
                    }
                    
                    // Handle Timeout
                    if (retry_count >= max_retries) {
                        clearInterval(interval);
                        $("#pay_btn").prop("disabled", false).text(__("Try Again"));
                        $("#response_msg").html('<div class="alert alert-warning">Transaction timed out. If you paid, please check your invoice in a few minutes.</div>');
                    }
                }
            });
        }, 5000); // Check every 5 seconds
    }
});
</script>
{% endblock %}
